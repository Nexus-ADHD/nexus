# Apple Search Ads tooling — generated snapshots, CSVs, and the JSONL audit log.
# (tools/asa/ secrets come from .env*.local + *.p8, already ignored above.)
tools/asa/out/

app-example

# generated native folders — except the hand-maintained NexusWidget
# extension and the pbxproj that wires its target (this repo archives
# manually from ios/Nexus.xcworkspace and is NOT prebuild-managed;
# `expo prebuild --clean` would destroy both, so they live in git).
# `/ios/*` (not `/ios`) so git descends to apply the negations below.
/ios/*
!/ios/NexusWidget/
!/ios/Nexus.xcodeproj/
/ios/Nexus.xcodeproj/*
!/ios/Nexus.xcodeproj/project.pbxproj
# The shared scheme is what lets eas-cli submit from a fresh checkout
# (its local validation refuses projects with no scheme). Generated by
# prebuild but static — tracked deliberately; xcuserdata stays ignored.
!/ios/Nexus.xcodeproj/xcshareddata/
# AppDelegate.swift: eas-cli's expo-updates config sync locates the app
# delegate at submission time and errors without it ("Could not locate a
# valid AppDelegate"). Prebuild-generated, effectively static — tracked so
# fresh checkouts can submit.
!/ios/Nexus/
/ios/Nexus/*
!/ios/Nexus/AppDelegate.swift
# Podfile.lock pins pod versions so archives are reproducible on a
# replacement machine — it's the disaster-recovery artifact the widget
# tracking exists to protect. (Podfile itself is prebuild-regenerated.)
!/ios/Podfile.lock
/android

# AI agent configurations (local only)
.agents/
# .claude/ is mostly local, but share settings, the starter-kit skills/agents, and hooks
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/ship-pr/
!.claude/skills/session-wrapup/
!.claude/skills/transcript-mine/
!.claude/skills/write-plan/
!.claude/skills/implement-plan/
!.claude/skills/handoff/
!.claude/skills/work-ticket/
!.claude/skills/spec/
!.claude/agents/
.claude/agents/*
!.claude/agents/plan-reviewer.md
!.claude/agents/code-reviewer.md
!.claude/agents/design-researcher.md
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/greptile-watch.sh
!.claude/hooks/fleet-guard.sh
.claude/settings.local.json
.claude-flow/
.gitnexus/
*.bak
.harness-picked-ticket
.nexus-backups/

# Supabase CLI writes this version-cache file on EVERY invocation, so a tracked
# copy makes the working tree dirty after any `supabase` command. That breaks
# scripts/deploy-edge-function.sh, whose prod gate refuses a dirty tree — the
# script's own staging step dirtied it and then its gate rejected the deploy.
# The other supabase/.temp/* files are deliberately left tracked: they are stable
# link state, not per-run churn.
supabase/.temp/cli-latest

# EAS-downloaded signing material (contains private keys) — never commit
credentials.json
credentials/
