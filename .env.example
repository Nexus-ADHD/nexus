# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. Never commit real values.
#
# Only EXPO_PUBLIC_* values reach the app bundle. Everything public here is
# safe to ship in a client build. Server secrets live in Supabase (see the
# bottom section) and are never read by the app.

# ---------------------------------------------------------------------------
# App: required
# ---------------------------------------------------------------------------

# Supabase project URL and anon key (Project Settings > API).
# The anon key is public and gated by row level security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI proxy. The app never holds a model provider key. All AI calls go to the
# ai-proxy edge function, which holds provider keys server side.
#   URL:   https://<your-project-ref>.supabase.co/functions/v1/ai-proxy
#   TOKEN: any long random string. Set the same value as AI_PROXY_APP_TOKEN
#          on the function (below). It is sent as the X-App-Token header.
EXPO_PUBLIC_AI_PROXY_URL=
EXPO_PUBLIC_AI_PROXY_TOKEN=

# ---------------------------------------------------------------------------
# App: optional (features turn off cleanly when these are empty)
# ---------------------------------------------------------------------------

# RevenueCat public Apple SDK key (subscriptions and paywall).
EXPO_PUBLIC_REVENUECAT_API_KEY=

# PostHog product analytics.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry crash reporting DSN. Empty disables Sentry.
EXPO_PUBLIC_SENTRY_DSN=

# Google Sign-In (iOS OAuth client ID, ends in .apps.googleusercontent.com).
# app.config.js registers the reversed ID as a URL scheme automatically.
EXPO_PUBLIC_GOOGLE_SIGNIN_IOS_CLIENT_ID=

# External calendar sync.
EXPO_PUBLIC_GOOGLE_CALENDAR_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CALENDAR_REDIRECT_URI=
EXPO_PUBLIC_MICROSOFT_CALENDAR_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_CALENDAR_REDIRECT_URI=

# Comma separated Supabase user IDs to tag as internal in analytics.
EXPO_PUBLIC_INTERNAL_USER_IDS=

# Override the voice parse model (see src/ai/models.js).
EXPO_PUBLIC_OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Build and release (only needed to ship your own build)
# ---------------------------------------------------------------------------

# From `eas init`. Enables EAS Update.
EAS_PROJECT_ID=
# Your own bundle ID. Defaults to the one in app.json.
IOS_BUNDLE_ID=
# Apple Developer team ID, used by scripts/add-native-targets.js.
APPLE_TEAM_ID=
# App Store Connect API key, used by .eas/build/widgets.yml to upload builds.
ASC_API_KEY_ID=
ASC_API_ISSUER_ID=
ASC_APP_ID=
# ASC_API_KEY_P8_B64 is a secret. Store it as an EAS secret, not here.
# Sentry source map upload. SENTRY_AUTH_TOKEN is a secret; keep it in
# ios/sentry.properties (gitignored) or an EAS secret.
SENTRY_ORG=
SENTRY_PROJECT=
# Used by scripts/deploy-edge-function.sh.
SUPABASE_STAGING_REF=
SUPABASE_PROD_REF=

# ---------------------------------------------------------------------------
# Edge function secrets (set with `supabase secrets set NAME=value`)
# Listed here for reference only. Do not put real values in this file.
# ---------------------------------------------------------------------------
# AI_PROXY_APP_TOKEN=            same value as EXPO_PUBLIC_AI_PROXY_TOKEN
# AI_PROXY_APP_TOKEN_PREVIEW=    optional second token for preview builds
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=              optional
# BRAINTRUST_API_KEY=            optional, AI tracing
# RESEND_API_KEY=                lifecycle emails
# FROM_EMAIL=                    e.g. "Nexus <hello@yourdomain.com>"
# REPLY_TO_EMAIL=
# ONBOARDING_CALL_URL=           optional booking link in the purchase email
# REVENUECAT_SECRET_KEY=
# REVENUECAT_WEBHOOK_AUTH=
# RC_WINBACK_ENABLED=
# RC_WINBACK_ALLOWED_ENV=
# POSTHOG_HOST=
# POSTHOG_PROJECT_ID=
# POSTHOG_PROJECT_API_KEY=
# POSTHOG_PERSONAL_API_KEY=
# SENTRY_EDGE_DSN=
# TWILIO_ACCOUNT_SID=            SMS features
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
# SMS_WEBHOOK_URL=
# SMS_BROADCAST_ADMIN_TOKEN=
# SMS_DAILY_QUOTES_ENABLED=
# SMS_DAILY_QUOTES_SCHEDULER_SECRET=
# SMS_WEEKLY_BROADCAST_ENABLED=
# WEEKLY_SCHEDULER_SECRET=
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# to edge functions by Supabase automatically.
